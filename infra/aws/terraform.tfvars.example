region      = "eu-west-1"
name_prefix = "travel-ai"

# Image digests, so a new image redeploys the function (a mutable tag would not).
core_api_image = "123456789012.dkr.ecr.eu-west-1.amazonaws.com/travel-ai-core-api@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ai_api_image   = "123456789012.dkr.ecr.eu-west-1.amazonaws.com/travel-ai-ai-api@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Use real values only in a local ignored terraform.tfvars file or CI variables.
nvidia_api_key       = "replace-me"
google_client_secret = "replace-me"
# google_client_id defaults to the project's OAuth client (variables.tf); set it only
# together with the secret of another client.

# The frontend (CloudFront + S3) and the API share this domain; it must be a
# public hosted zone in this account with the ACM certificate in us-east-1.
domain_name          = "www.example.com"
frontend_bucket_name = "www.example.com"

# Optional: the Cognito managed-login host (the certificate must cover it).
# cognito_subdomain = "auth"   # "" keeps the pool's default *.amazoncognito.com host

# Administrators (ADR 0024) are NOT set here: they live in the committed
# `admins.auto.tfvars`, which Terraform loads by itself (this file is ignored by
# git and absent in CI, so a list here would be emptied by the CI deploy).
