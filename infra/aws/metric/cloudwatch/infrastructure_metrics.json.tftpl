          ],
          [
            "AWS/DynamoDB",
            "WriteThrottleEvents",
            "TableName",
            "${traces_table}",
            "GlobalSecondaryIndexName",
            "GSI1",
            {
              "label": "interactions · GSI1"
            }
          ],
          [
            "AWS/DynamoDB",
            "WriteThrottleEvents",
            "TableName",
            "${traces_table}",
            "GlobalSecondaryIndexName",
            "GSI2",
            {
