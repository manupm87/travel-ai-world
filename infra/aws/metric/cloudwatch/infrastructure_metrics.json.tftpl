          ],
          [
            "AWS/DynamoDB",
            "ThrottledRequests",
            "TableName",
            "${core_table}",
            "Operation",
            "BatchGetItem",
            {
              "label": "BatchGetItem"
            }
          ],
          [
            "AWS/DynamoDB",
            "ThrottledRequests",
            "TableName",
            "${core_table}",
            "Operation",
            "BatchWriteItem",
            {
              "label": "BatchWriteItem"
            }
          ],
          [
            "AWS/DynamoDB",
            "ThrottledRequests",
            "TableName",
            "${core_table}",
            "Operation",
            "TransactGetItems",
            {
