{
  "start": "-PT3H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 3,
      "properties": {
        "markdown": "# Kyrian World · Infraestructura\n**DynamoDB · CloudFront · Lambda** · Últimas 3 horas · Períodos de 1 minuto · Actualización manual."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "DynamoDB · unidades de lectura consumidas/min",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/DynamoDB",
            "ConsumedReadCapacityUnits",
            "TableName",
            "${core_table}",
            {
              "label": "core"
            }
          ],
          [
            "AWS/DynamoDB",
            "ConsumedReadCapacityUnits",
            "TableName",
            "${traces_table}",
            {
              "label": "interactions"
            }
          ]
        ],
        "legend": {
          "position": "bottom"
        },
        "yAxis": {
          "left": {
            "min": 0,
            "label": "unidades/min",
            "showUnits": false
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "DynamoDB · unidades de escritura consumidas/min",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/DynamoDB",
            "ConsumedWriteCapacityUnits",
            "TableName",
            "${core_table}",
            {
              "label": "core"
            }
          ],
          [
            "AWS/DynamoDB",
            "ConsumedWriteCapacityUnits",
            "TableName",
            "${traces_table}",
            {
              "label": "interactions"
            }
          ]
        ],
        "legend": {
          "position": "bottom"
        },
        "yAxis": {
          "left": {
            "min": 0,
            "label": "unidades/min",
            "showUnits": false
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "DynamoDB · eventos de lectura limitados/min",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${core_table}",
            {
              "label": "core · tabla"
            }
          ],
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${core_table}",
            "GlobalSecondaryIndexName",
            "GSI1",
            {
              "label": "core · GSI1"
            }
          ],
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${core_table}",
            "GlobalSecondaryIndexName",
            "GSI2",
            {
              "label": "core · GSI2"
            }
          ],
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${traces_table}",
            {
              "label": "interactions · tabla"
            }
          ],
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${traces_table}",
            "GlobalSecondaryIndexName",
            "GSI1",
            {
              "label": "interactions · GSI1"
            }
          ],
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${traces_table}",
            "GlobalSecondaryIndexName",
            "GSI2",
            {
              "label": "interactions · GSI2"
            }
          ]
        ],
        "legend": {
          "position": "bottom"
        },
        "yAxis": {
          "left": {
            "min": 0,
            "label": "eventos/min",
            "showUnits": false
          }
        }
      }
    },
