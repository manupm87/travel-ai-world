            "AWS/DynamoDB",
            "ThrottledRequests",
            "TableName",
            "${core_table}",
            "Operation",
            "PutItem",
            {
              "label": "PutItem"
            }
          ],
          [
            "AWS/DynamoDB",
            "ThrottledRequests",
            "TableName",
            "${core_table}",
            "Operation",
            "UpdateItem",
            {
              "label": "UpdateItem"
            }
          ],
          [
            "AWS/DynamoDB",
            "ThrottledRequests",
            "TableName",
            "${core_table}",
            "Operation",
            "DeleteItem",
            {
              "label": "DeleteItem"
