    {
      "id": 103,
      "title": "Creaciones observadas · por hora",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Logs",
          "logsMode": "Insights",
          "queryLanguage": "CWLI",
          "logsQueryScope": "logGroupName",
          "region": "$region",
          "logGroups": [
            {
              "arn": "$core_log_group",
              "name": "$core_log_group"
            }
          ],
          "expression": "parse @message \"business_event=*\" as payload\n| fields jsonParse(payload) as e\n| filter e.event = \"trip_created\" and e.version = 1 and ispresent(e.event_id)\n| stats latest(e.city_slug) as city_slug, latest(e.budget_tier) as budget_tier, latest(e.pace_preference) as pace_preference, latest(e.duration_days) as duration_days, max(@timestamp) as ts by e.event_id\n| stats count(*) as viajes by datefloor(ts, 1h) as intervalo\n| sort intervalo asc",
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin muestras",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 65,
            "showPoints": "never",
            "axisCenteredZero": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "viajes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Viajes observados"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "intervalo",
                "destinationType": "time"
              }
            ],
            "fields": {}
          }
        }
      ]
    },
    {
      "id": 104,
      "title": "Tráfico y errores de core_api · cada 5 min",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Logs",
          "logsMode": "Insights",
          "queryLanguage": "CWLI",
          "logsQueryScope": "logGroupName",
          "region": "$region",
          "logGroups": [
            {
              "arn": "$core_log_group",
              "name": "$core_log_group"
            }
          ],
          "expression": "parse @message \"access_log=*\" as payload\n| fields jsonParse(payload) as a\n| filter a.version = 1 and ispresent(a.status) and ispresent(a.duration_ms)\n| stats count(*) as peticiones, sum(if(a.status >= 500 and a.status < 600, 1, 0)) as respuestas_5xx by bin(5m) as intervalo\n| sort intervalo asc",
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin muestras",
          "decimals": 0,
