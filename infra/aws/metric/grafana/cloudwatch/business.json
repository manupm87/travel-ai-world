      "targets": [
        {
          "refId": "A",
          "id": "",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Logs",
          "logsMode": "Insights",
          "queryLanguage": "CWLI",
          "logsQueryScope": "logGroupName",
          "region": "$region",
          "logGroups": [
            {
              "arn": "$core_log_group",
              "name": "$core_log_group"
            }
