    {
      "id": 7,
      "title": "Creaciones por hora",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "description": "Actividad por hora según la última observación de cada creación dentro del periodo. Los huecos sin eventos se mantienen sin rellenar; no se inventan ceros.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisLabel": "Viajes creados",
            "axisCenteredZero": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "displayName": "Viajes creados"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "id": "",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Logs",
          "logsMode": "Insights",
          "queryLanguage": "CWLI",
          "logsQueryScope": "logGroupName",
          "region": "$region",
          "logGroups": [
            {
              "arn": "$core_log_group",
              "name": "$core_log_group"
            }
          ],
          "expression": "parse @message \"business_event=*\" as payload\n| fields jsonParse(payload) as e\n| filter e.event = \"trip_created\" and e.version = 1 and ispresent(e.event_id)\n| stats latest(e.city_slug) as city_slug, latest(e.budget_tier) as budget_tier, latest(e.pace_preference) as pace_preference, latest(e.duration_days) as duration_days, max(@timestamp) as ts by e.event_id\n| stats count(*) as viajes by datefloor(ts, 1h) as intervalo\n| sort intervalo asc",
          "statsGroups": [
            "intervalo"
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
