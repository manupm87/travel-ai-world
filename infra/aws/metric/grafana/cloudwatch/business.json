      "description": "Actividad por hora según la última observación de cada creación dentro del periodo. Los huecos sin eventos se mantienen sin rellenar; no se inventan ceros.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisLabel": "Viajes creados",
            "axisCenteredZero": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
