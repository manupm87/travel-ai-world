      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kyrian-prometheus"
          },
          "expr": "sum(trip_duration_days_sum{job=\"core_api\"}) / (sum(trip_duration_days_count{job=\"core_api\"}) > 0)",
          "legendFormat": "{{city_slug}}",
          "instant": true,
          "range": false
        }
      ]
    },
