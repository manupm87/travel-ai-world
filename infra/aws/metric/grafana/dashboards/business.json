{
  "uid": "kyrian-business",
  "title": "Kyrian World — Métricas de negocio",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "kyrian",
    "negocio",
    "local"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Viajes creados",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Valor al final del intervalo seleccionado; con un rango relativo terminado en ahora, refleja el proceso actual desde su último reinicio. No representa el número de viajes almacenados.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kyrian-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kyrian-prometheus"
          },
          "expr": "sum(trips_created_total{job=\"core_api\"})",
          "legendFormat": "{{city_slug}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Duración media",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Solo duraciones explícitas, incluido cero. Sin datos cuando no hay duraciones conocidas. Valor al final del intervalo seleccionado; con un rango relativo terminado en ahora, refleja el proceso actual desde su último reinicio. No representa el número de viajes almacenados.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: días",
          "noValue": "Sin datos",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
