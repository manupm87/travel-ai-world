# One ignore file for the whole monorepo (Python, Node, Terraform, secrets, editors).

# Secrets and local configuration
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
# The admin list holds no secret and CI's apply must see it (ADR 0024, TRA-231).
!infra/aws/admins.auto.tfvars
*.pem
*.key
*.crt

# Python (uv workspace under src/backend, scraper, scripts)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
*.egg-info/
*.db
*.sqlite3

# City corpus drafts (`python -m city_corpus discover`); the reviewed <slug>.toml is committed
src/backend/tools/city_corpus/cities/*.draft.toml

# Node / Next.js (src/frontend)
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*

# Terraform (infra/*)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Scraper datasets are versioned for reproducible retrieval ingestion.
# city_corpus: data/ is committed (source of truth); raw API downloads are not.
src/backend/tools/city_corpus/.cache/

# Editors, OS, logs
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.log

# Coding-agent local state (shared rules live in AGENTS.md, .claude/CLAUDE.md and .claude/settings.json)
.claude/settings.local.json
.superpowers/
.cursor/
.debug/

# Terraform plan files embed every variable value, secrets included
tfplan
*.tfplan
# Spike: the packaged bench function and the dependencies build.sh vendors into
# it are build output (16 MB), never sources.
src/backend/tools/vector_store_bench/bench_lambda/build/
src/backend/tools/vector_store_bench/bench_lambda/bench.zip

# Spike artefacts: the 24 MB vector matrix stays out of git (it is deterministic and
# lives in S3); the manifest and the query vectors are small and are committed.
src/backend/tools/vector_store_bench/.artifacts/**/vectors.npy
src/backend/tools/vector_store_bench/.artifacts/**/ids.json

# MapLibre worker copied from node_modules by src/frontend/scripts/copy-maplibre-worker.mjs (TRA-181)
src/frontend/public/maplibre/
