# Sign-in (ADR 0009): with both Cognito variables set the app uses the user pool's managed
# login (deployed); without them, the Google button and core_api's /auth/google (local).
# Values: `terraform output` in infra/aws (cognito_domain, cognito_client_id).
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Google OAuth client ID, for the local Google flow only.
# Get yours at: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local modes (docs/runbooks/local-dev.md):
# 1. `just dev-frontend` (:3000) talks over CORS to the uvicorn processes (the values below)
#    or to the Compose proxy (NEXT_PUBLIC_API_URL=http://localhost:8080, NEXT_PUBLIC_AI_API_URL empty).
# 2. `just stack-up` sets both on the command line (overriding this file); nginx serves the
#    export on the API's origin, like CloudFront, so no CORS.

# core_api URL (auth, users, trips). Omit for a static-only build (recorded demo, no sign-in API).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ai_api URL (planner). Optional: defaults to NEXT_PUBLIC_API_URL (ADR 0003), which
# is right behind a single origin (Compose :8080; on AWS, CloudFront routes /api/* to
# API Gateway for both services). Set it only when the two services have different
# origins (two uvicorn processes).
NEXT_PUBLIC_AI_API_URL=http://localhost:8001
