# Sign-in (ADR 0009). With the two Cognito variables set, the app signs in
# through the user pool's managed login (deployed). Without them it uses the
# Google Identity Services button and core_api's /auth/google (local).
# Values come from `terraform output` in infra/aws (cognito_domain, cognito_client_id).
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Google OAuth client ID, for the local Google flow only.
# Get yours at: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# core_api URL (auth, users, trips). Omit for a static-only GitHub Pages build.
# Docker Compose (reverse proxy): http://localhost:8080 — local uvicorn: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ai_api URL (chat). Optional: defaults to NEXT_PUBLIC_API_URL, which is right
# behind the reverse proxy. Set it when the two services have different origins
# (e.g. two Cloud Run URLs, or two local uvicorn processes on 8000 and 8001).
NEXT_PUBLIC_AI_API_URL=http://localhost:8001
