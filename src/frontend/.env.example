# Sign-in (ADR 0009). With the two Cognito variables set, the app signs in
# through the user pool's managed login (deployed). Without them it uses the
# Google Identity Services button and core_api's /auth/google (local).
# Values come from `terraform output` in infra/aws (cognito_domain, cognito_client_id).
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Google OAuth client ID, for the local Google flow only.
# Get yours at: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Two local modes (docs/runbooks/local-dev.md):
#
# 1. Hot-reload dev: `just dev-frontend` on :3000 talks cross-origin (CORS) to
#    the backends, either the two uvicorn processes (`just dev-core` :8000 and
#    `just dev-ai` :8001, the values below) or the Compose proxy
#    (NEXT_PUBLIC_API_URL=http://localhost:8080 and NEXT_PUBLIC_AI_API_URL empty).
# 2. The stack as deployed: `just stack-up` builds the export with
#    NEXT_PUBLIC_API_URL=http://localhost:8080 and NEXT_PUBLIC_AI_API_URL= set on
#    the command line (they override this file) and nginx serves it on the same
#    origin as the API, like CloudFront in production. No CORS involved.

# core_api URL (auth, users, trips). Omit for a static-only GitHub Pages build.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ai_api URL (chat). Optional: defaults to NEXT_PUBLIC_API_URL (ADR 0003), which
# is right behind a reverse proxy (Compose :8080, CloudFront). Set it only when
# the two services have different origins (two uvicorn processes, two Cloud Run URLs).
NEXT_PUBLIC_AI_API_URL=http://localhost:8001
