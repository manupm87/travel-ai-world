{
  "name": "frontend",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:static": "next build && playwright test --config playwright.static.config.ts",
    "test:e2e:stack": "playwright test --config playwright.stack.config.ts",
    "test:unit": "vitest run",
    "types:generate": "openapi-typescript ../../docs/api/core-api.openapi.json -o src/types/generated/core-api.ts && openapi-typescript ../../docs/api/ai-api.openapi.json -o src/types/generated/ai-api.ts",
    "types:check": "npm run types:generate && git diff --exit-code -- src/types/generated"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.81",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
