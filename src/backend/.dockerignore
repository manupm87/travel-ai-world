# ==============================================================================
# Docker Build Ignore File
# Keeps the Docker image context small and secure.
# ==============================================================================

# Git
.git
.gitignore

# Environment Variables & Secrets (also the per-service ones under services/*/)
**/.env
**/.env.*
!**/.env.example
certs/
*.pem
*.key
*.crt

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml

# Virtual environments (images build their own in /opt/venv)
venv/
.venv/
env/

# IDEs & OS Files
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Tests and Docs (keep tests out of the build context; every package has a tests/)
**/tests/
docs/
*.md
!README.md

# AI Agents & Assistants (not needed inside the container runtime)
.claude/
.cursor/
.cursorrules

# Docker / Compose
docker-compose.yml
.dockerignore
Dockerfile

# Local DBs
*.db
*.sqlite3

# Scripts (dev-only tooling) and scraper output
scripts/
tools/*/data/
