# App Config
PROJECT_NAME="Kyrian World — Core API"
API_V1_STR="/api/v1"
# VERSION="1.0.0"
# LOG_LEVEL="INFO"

# Who issues the bearer tokens (ADR 0009). "local": this service issues HS256
# tokens from POST /auth/google (development). "cognito": the Amazon Cognito
# user pool issues RS256 ID tokens and /auth/google does not exist.
AUTH_MODE="local"

# Local mode. SECRET_KEY REQUIRED and the SAME value as ai_api/.env (both verify
# the same JWTs). Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Local mode: Google OAuth 2.0 client (REQUIRED), used to verify the browser's
# ID token. Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cognito mode (deployed): the pool's issuer, the app client id (audience) and
# the pool's JWKS document as one JSON line, all from `terraform output`.
# COGNITO_ISSUER="https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_xxxxxxxxx"
# COGNITO_CLIENT_ID=""
# COGNITO_JWKS='{"keys":[...]}'

# CORS — frontend origins (JSON list). Set to the deployed frontend in production.
# :3000 is the hot-reload dev server. The Compose stack (`just stack-up`) serves the
# frontend and the API on the same origin (:8080), so it needs no entry here.
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Set by AWS Lambda, never here: enables POST /events (direct-invocation commands).
# AWS_LAMBDA_FUNCTION_NAME=""

# PostgreSQL (the only supported engine)
# Local: 127.0.0.1. Docker Compose and the devcontainer override DB_SERVER themselves.
DB_SERVER="127.0.0.1"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="postgres"

# DynamoDB (ADR 0023). Leave DYNAMODB_ENDPOINT_URL empty on AWS (the regional
# endpoint, credentials from the function's role). Locally point it at
# `just dynamodb-local` (moto, http://localhost:8002); Docker Compose and the
# devcontainer set http://dynamodb:8000 (DynamoDB Local) themselves.
DYNAMODB_ENDPOINT_URL="http://localhost:8002"
AWS_REGION="eu-west-1"
