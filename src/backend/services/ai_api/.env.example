# App Config
PROJECT_NAME="Kyrian World — AI API"
API_V1_STR="/api/v1"
# VERSION="1.0.0"
# LOG_LEVEL="INFO"

# Who issues the bearer tokens (ADR 0009): "local" (core_api, HS256) or
# "cognito" (the Amazon Cognito user pool, RS256). Same value as core_api/.env.
AUTH_MODE="local"

# Local mode. SECRET_KEY REQUIRED and the SAME value as core_api/.env: this
# service verifies the JWTs core_api issues. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
# Only the issuer (core_api) uses the lifetime; documented here because the JWT codec is shared.
# ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Cognito mode (deployed): same three values as core_api, from `terraform output`.
# COGNITO_ISSUER="https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_xxxxxxxxx"
# COGNITO_CLIENT_ID=""
# COGNITO_JWKS='{"keys":[...]}'

# Which adapter answers the chat: "nvidia" (local development, needs
# NVIDIA_API_KEY) or "bedrock" (deployed: Amazon Bedrock with the function's
# IAM role, no key). Terraform sets "bedrock" on the Lambda.
LLM_PROVIDER="nvidia"

# NVIDIA AI Chat (REQUIRED when LLM_PROVIDER=nvidia)
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=""
NVIDIA_CHAT_MODEL="nvidia/nemotron-3-super-120b-a12b"
# Optional (defaults shown): endpoint, timeouts, retries and sampling
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_CONNECT_TIMEOUT="10"
# NVIDIA_READ_TIMEOUT="120"
# NVIDIA_MAX_RETRIES="2"
# NVIDIA_THINKING="false"   # let reasoning models think before answering
# CHAT_MAX_TOKENS="4096"
# CHAT_TEMPERATURE="0.7"
# CHAT_TOP_P="0.95"          # NVIDIA only: Claude 4.5+ refuses it together with temperature

# Amazon Bedrock (LLM_PROVIDER=bedrock). No key: credentials come from the
# environment (the Lambda's role; locally `just aws-login` + AWS_PROFILE).
# Model IDs are cross-region inference profiles ("eu." prefix) so requests
# stay in EU regions; confirm them with `aws bedrock list-inference-profiles`.
# BEDROCK_REGION="eu-west-1"
# BEDROCK_CHAT_MODEL="eu.anthropic.claude-haiku-4-5-20251001-v1:0"
# BEDROCK_TITLE_MODEL="eu.amazon.nova-lite-v1:0"   # short completions (conversation titles)
# BEDROCK_CONNECT_TIMEOUT="10"
# BEDROCK_READ_TIMEOUT="120"
# BEDROCK_MAX_RETRIES="2"

# core_api base URL (used when AI output has to be persisted)
# Docker Compose: http://core_api:8000 — local: http://localhost:8000
CORE_API_URL="http://localhost:8000"
# Record every answered exchange in core_api (chat_threads / chat_messages).
# If core_api is not running the chat still answers and logs a warning; set it to
# false when running ai_api on its own.
# CHAT_RECORD_CONVERSATIONS="true"

# Retrieval (ADR 0014). The chat answers from a corpus of city documents kept
# in an Amazon S3 Vectors index, created by Terraform and filled with
# `just index`. Credentials come from the environment, like Bedrock's. With
# RETRIEVAL_ENABLED=false the chat answers from the model's own knowledge and
# never touches AWS for it.
# RETRIEVAL_ENABLED="false"
# RETRIEVAL_LIMIT="6"              # passages handed to the model per question
# VECTOR_BUCKET="travel-ai-vectors"
# VECTOR_INDEX="city-kb"
# VECTOR_REGION="eu-west-1"
# EMBEDDINGS_MODEL="amazon.titan-embed-text-v2:0"
# EMBEDDINGS_REGION="eu-west-1"
# EMBEDDINGS_DIMENSIONS="1024"     # frozen by the index; changing it needs a new one
# EMBEDDINGS_CONCURRENCY="8"       # calls in flight while indexing

# Planner (POST /api/v1/ai/planner, ADR 0015). Needs RETRIEVAL_ENABLED=true:
# every card it shows is a corpus document. Defaults shown.
# PLANNER_CITIES='["budapest"]'     # narrow to these manifest slugs; unset = every city in data/cities.json
# PLANNER_MAX_DAYS="7"              # longest draft generated in one turn
# PLANNER_CANDIDATES="8"            # documents the model picks from per part of a day
# OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
# OPEN_METEO_TIMEOUT="5"            # seconds; beyond 16 days the corpus's climate normals are used
# PHOTOS_ENABLED="true"             # look up a Wikimedia Commons photo for cards the corpus has none for
# COMMONS_API_URL="https://commons.wikimedia.org/w/api.php"
# COMMONS_TIMEOUT="4"               # seconds per lookup; a miss shows an illustrative photo instead
# A venue Commons has no photo of shows the image its own site publishes as
# its link preview (og:image), credited with the site's domain (ADR 0021).
# SITE_PREVIEWS_ENABLED="true"      # off: such a card shows the illustrative placeholder
# SITE_PREVIEW_TIMEOUT="2"          # seconds to connect and to read the venue's page
# SITE_PREVIEW_MAX_BYTES="262144"   # HTML read per page before the parser stops
# SITE_PREVIEW_CACHE_SECONDS="86400"  # how long a preview (or a miss) is kept in memory

# CORS — frontend origins (JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# DynamoDB (ADR 0023). Leave DYNAMODB_ENDPOINT_URL empty on AWS (the regional
# endpoint, credentials from the function's role). Locally point it at
# `just dynamodb-local` (moto, http://localhost:8002); Docker Compose and the
# devcontainer set http://dynamodb:8000 (DynamoDB Local) themselves.
DYNAMODB_ENDPOINT_URL="http://localhost:8002"
AWS_REGION="eu-west-1"

# Traces (ADR 0024): every planner turn, chat answer and card detail is written
# to this DynamoDB table (summary, context, one item per step, SSE timeline).
# Empty (the default) records nothing. Locally: set it, run `just dynamodb-local`
# (or Compose) and the table is created at start-up; on AWS Terraform owns it.
# INTERACTIONS_TABLE="travel-ai-local-interactions"
# INTERACTION_TTL_DAYS="90"         # days a trace is kept (TTL on expires_at)
# TRACE_PAYLOAD_BYTES="8192"        # longest text one trace field keeps (UTF-8 bytes)
